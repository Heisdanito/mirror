{
  "expo": {
    "name": "Mirror",
    "slug": "mirror",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.heisdev.mirror"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F1EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.heisdev.mirror"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Mirror lets you attach photos from your library to journal entries. Photos stay on this phone.",
          "cameraPermission": "Mirror lets you take a photo to attach to a journal entry. Photos stay on this phone.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "mirror"
  }
}
